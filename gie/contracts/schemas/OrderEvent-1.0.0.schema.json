  "x-gie-invariants": [
    {
      "id": "OEV-1",
      "rule": "order_event_id equals identity.order_event_id(client_order_id, order_seq)"
    },
    {
      "id": "OEV-2",
      "rule": "order_seq is 0 if and only if event_type is SUBMIT_REQUESTED"
    },
    {
      "id": "OEV-3",
      "rule": "order_state is a state that event_type can lead to (see ORDER_TRANSITIONS)"
    },
    {
      "id": "OEV-4",
      "rule": "limit_price is set iff order_type is LIMIT; trigger_price is set iff order_type is STOP"
    },
    {
      "id": "OEV-5",
      "rule": "an ENTRY order carries its plan, risk approval, alternative group, reference price and protective stop, and no position"
    },
    {
      "id": "OEV-6",
      "rule": "a non-ENTRY order names the position it protects or closes and carries no plan, approval, alternative group or attached protection"
    },
    {
      "id": "OEV-7",
      "rule": "client_order_id equals identity.client_order_id(run_id, origin, intent, attempt) with origin = risk_decision_id and attempt = 0 for ENTRY, origin = position_id otherwise"
    },
    {
      "id": "OEV-8",
      "rule": "a PROTECTIVE_STOP is a STOP order and a TAKE_PROFIT is a LIMIT order"
    },
    {
      "id": "OEV-9",
      "rule": "fill fields are consistent: last_fill_lots, last_fill_price and the matched quote (fill_tick_source, fill_tick_seq) are set together, always on PARTIALLY_FILLED and FILLED, optionally on RECONCILED (a fill found by reconciliation) and never otherwise; last_fill_cost_amount only with a fill; 0 <= cumulative <= volume; average_fill_price iff cumulative > 0; order_state is FILLED iff cumulative = volume; PENDING_SUBMIT and WORKING have no fills, PARTIALLY_FILLED has some"
    },
    {
      "id": "OEV-10",
      "rule": "reason_code is set on REJECTED, CANCEL_REJECTED, REPLACE_REJECTED and RECONCILED events"
    },
    {
      "id": "OEV-11",
      "rule": "attached protection is on the correct side of the price asked for (limit, trigger, or the reference price of a market order): stop on the losing side, take profit on the winning side; a fill price is a fact and is not judged"
    },
    {
      "id": "OEV-12",
      "rule": "event_time_ns <= receive_time_ns (the venue is simulated in-process, so there is no clock offset)"
    },
    {
      "id": "OEV-13",
      "rule": "a LIMIT or STOP entry has valid_until_ns; a protective stop never has one; an order is requested, and fills, strictly before valid_until_ns"
    },
    {
      "id": "OEV-14",
      "rule": "requested_* values are carried while a replacement is outstanding: always in PENDING_REPLACE, possibly in PENDING_CANCEL (cancel requested before the replacement was answered), never in any other state"
    },
    {
      "id": "OEV-15",
      "rule": "only GIE's execution engine creates an ENTRY (originator EXECUTION); an order created by the simulated broker states why (reason_code)"
    },
    {
      "id": "OEV-16",
      "rule": "a MARKET order carries the reference price it was requested against; max_slippage only on an ENTRY"
    },
    {
      "id": "OEV-17",
      "rule": "a resting entry rests beyond the market it was priced against: BUY LIMIT <= reference, SELL LIMIT >= reference, BUY STOP >= reference, SELL STOP <= reference"
    },
    {
      "id": "OEV-18",
      "rule": "broker_order_id, when present, equals identity.broker_order_id(client_order_id)"
    }
  ]
}
