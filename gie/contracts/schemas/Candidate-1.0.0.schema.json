{
  "$comment": "Necessary but not sufficient: decimal bounds (x-gie-*), canonical order, cross-field invariants (x-gie-invariants), lifecycle rules (x-gie-behaviour), exact 64-bit integer tokens and printable-text rules are enforced by the reference implementation gie.contracts.",
  "$defs": {
    "Contribution": {
      "additionalProperties": false,
      "description": "Share of an estimate attributed to one driver (explainability).",
      "minProperties": 3,
      "properties": {
        "evidence_id": {
          "anyOf": [
            {
              "maxLength": 36,
              "minLength": 36,
              "pattern": "^evd_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Contributing evidence, or null for a named feature."
        },
        "feature": {
          "anyOf": [
            {
              "maxLength": 48,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]{1,47}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Contributing feature from the feature dictionary, or null for evidence."
        },
        "weight_r": {
          "description": "Signed contribution to the expected net R.",
          "type": "number",
          "x-gie-unit": "R"
        }
      },
      "required": [
        "weight_r"
      ],
      "type": "object",
      "x-gie-invariants": [
        {
          "id": "CONTRIB-1",
          "rule": "exactly one of evidence_id and feature is set"
        }
      ]
    },
    "Destination": {
      "additionalProperties": false,
      "description": "A price the market may travel to under a named scenario.",
      "minProperties": 5,
      "properties": {
        "horizon_ns": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Horizon of the probability; set if and only if it is.",
          "x-gie-unit": "ns"
        },
        "label": {
          "description": "Destination name.",
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{1,47}$",
          "type": "string"
        },
        "price": {
          "description": "Destination price.",
          "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,12})?$",
          "type": "string",
          "x-gie-exclusiveMinimum": "0",
          "x-gie-type": "decimal",
          "x-gie-unit": "USD per troy ounce"
        },
        "probability_frac": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Probability of touching the price within horizon_ns; null when not estimated.",
          "x-gie-unit": "fraction"
        },
        "scenario": {
          "description": "Scenario name.",
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{1,47}$",
          "type": "string"
        }
      },
      "required": [
        "scenario",
        "label",
        "price"
      ],
      "type": "object",
      "x-gie-invariants": [
        {
          "id": "DEST-1",
          "rule": "probability_frac and horizon_ns are both set or both null"
        }
      ]
    },
    "QuantilePoint": {
      "additionalProperties": false,
      "description": "One point of the predictive distribution of net R.",
      "minProperties": 2,
      "properties": {
        "q_frac": {
          "description": "Cumulative probability.",
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "type": "number",
          "x-gie-unit": "fraction"
        },
        "value_r": {
          "description": "Net R at this quantile.",
          "type": "number",
          "x-gie-unit": "R"
        }
      },
      "required": [
        "q_frac",
        "value_r"
      ],
      "type": "object"
    }
  },
  "$id": "urn:gie:contract:Candidate:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Opportunity built from de-duplicated evidence, with one scorer's estimates.",
  "minProperties": 43,
  "properties": {
    "as_of_time_ns": {
      "description": "Market-data watermark: receive time of the newest market data the record depends on, directly or through its inputs.",
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer",
      "x-gie-unit": "ns since epoch, UTC"
    },
    "baseline_r": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "Part of expected_net_r not attributed to any listed contribution.",
      "x-gie-unit": "R"
    },
    "candidate_id": {
      "description": "identity.candidate_id(opportunity_id, model_version_id, revision).",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^cnd_[0-9a-f]{32}$",
      "type": "string"
    },
    "contract": {
      "const": "Candidate",
      "description": "Contract name."
    },
    "contributions": {
      "description": "Attribution of expected_net_r to evidence and features, as given by the scoring model.",
      "items": {
        "$ref": "#/$defs/Contribution"
      },
      "maxItems": 64,
      "minItems": 0,
      "type": "array",
      "x-gie-canonical-order": "sorted by driver",
      "x-gie-unique": true
    },
    "data_origin": {
      "description": "Least trustworthy origin among the market data the record is derived from.",
      "enum": [
        "BROKER_FEED",
        "HISTORICAL",
        "SYNTHETIC_FIXTURE"
      ],
      "type": "string"
    },
    "decision_time_ns": {
      "description": "Clock reading at which the producer created the record.",
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer",
      "x-gie-unit": "ns since epoch, UTC"
    },
    "destinations": {
      "description": "Scenario price destinations.",
      "items": {
        "$ref": "#/$defs/Destination"
      },
      "maxItems": 16,
      "minItems": 0,
      "type": "array",
      "x-gie-canonical-order": "sorted by (scenario, label)",
      "x-gie-unique": true
    },
    "evidence_ids": {
      "description": "Evidence revisions this revision of the candidate was built from.",
      "items": {
        "maxLength": 36,
        "minLength": 36,
        "pattern": "^evd_[0-9a-f]{32}$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true,
      "x-gie-canonical-order": "sorted ascending",
      "x-gie-unique": true
    },
    "expected_cost_r": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "Expected spread, commission and slippage already deducted in expected_net_r.",
      "x-gie-unit": "R"
    },
    "expected_holding_time_ns": {
      "anyOf": [
        {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "Expected holding time.",
      "x-gie-unit": "ns"
    },
    "expected_loss_r": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "Expected net size of a losing outcome, as a positive number.",
      "x-gie-unit": "R"
    },
    "expected_net_r": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "Expected net result.",
      "x-gie-unit": "R"
    },
    "expected_net_r_stderr": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "Standard error of expected_net_r itself (uncertainty of the estimate).",
      "x-gie-unit": "R"
    },
    "expected_win_r": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "Expected net size of a winning outcome.",
      "x-gie-unit": "R"
    },
    "horizon": {
      "description": "Scalp or intraday.",
      "enum": [
        "SCALP",
        "INTRADAY"
      ],
      "type": "string"
    },
    "market_event_ids": {
      "description": "Market events behind the opportunity (each counted once, whichever engines observed it).",
      "items": {
        "maxLength": 36,
        "minLength": 36,
        "pattern": "^mev_[0-9a-f]{32}$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true,
      "x-gie-canonical-order": "sorted ascending",
      "x-gie-unique": true
    },
    "memory_cutoff_time_ns": {
      "anyOf": [
        {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "Latest instant at which any retrieved historical case (neighbour) had become fully known, label included.  Prior-only retrieval means it is not later than as_of_time_ns.",
      "x-gie-unit": "ns since epoch, UTC"
    },
    "mode": {
      "description": "REPLAY or PAPER.  No live mode exists (routing lock).",
      "enum": [
        "REPLAY",
        "PAPER"
      ],
      "type": "string"
    },
    "model_status": {
      "anyOf": [
        {
          "enum": [
            "RESEARCH",
            "SHADOW",
            "ACTIVE",
            "RETIRED",
            "ROLLED_BACK",
            "REJECTED"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Promotion status of that model at decision time (only ACTIVE counts as validated)."
    },
    "model_version_id": {
      "anyOf": [
        {
          "maxLength": 36,
          "minLength": 36,
          "pattern": "^mdl_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Model (or rule set) version that produced the estimates; null when unscored."
    },
    "net_r_quantiles": {
      "description": "Optional predictive quantiles, ascending in q_frac.",
      "items": {
        "$ref": "#/$defs/QuantilePoint"
      },
      "maxItems": 32,
      "minItems": 0,
      "type": "array"
    },
    "net_r_stdev": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "Predictive standard deviation of a single net result (outcome dispersion).",
      "x-gie-unit": "R"
    },
    "opportunity_id": {
      "description": "identity.opportunity_id(setup_type, side, horizon, market_event_ids).",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^opp_[0-9a-f]{32}$",
      "type": "string"
    },
    "producer": {
      "description": "Component instance that emitted the record; together with the contract name it names the stream.",
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){0,4}$",
      "type": "string"
    },
    "quality_score": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "Model quality of the opportunity in this direction.",
      "x-gie-unit": "0..1"
    },
    "reference_price": {
      "description": "Executable price at decision time: ask for BUY, bid for SELL.",
      "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,12})?$",
      "type": "string",
      "x-gie-exclusiveMinimum": "0",
      "x-gie-type": "decimal",
      "x-gie-unit": "USD per troy ounce"
    },
    "revision": {
      "description": "0 for the first record, +1 per update.",
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "risk_unit_price": {
      "anyOf": [
        {
          "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,12})?$",
          "type": "string",
          "x-gie-exclusiveMinimum": "0",
          "x-gie-type": "decimal"
        },
        {
          "type": "null"
        }
      ],
      "description": "Price distance that equals 1 R in every *_r field of this record.",
      "x-gie-unit": "USD per troy ounce"
    },
    "run_id": {
      "description": "Run that produced the record (see the RunManifest of that run).",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^run_[0-9a-f]{32}$",
      "type": "string"
    },
    "schema_version": {
      "description": "Version of the contract the message was written with.",
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$",
      "type": "string"
    },
    "seq": {
      "description": "Position of the record in its stream: starts at 0 and increases by exactly 1.",
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "session": {
      "description": "Broker session at decision time.",
      "enum": [
        "ASIA",
        "LONDON",
        "NEW_YORK",
        "OFF_SESSION"
      ],
      "type": "string"
    },
    "setup_type": {
      "description": "Setup name from the feature dictionary.",
      "maxLength": 48,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]{1,47}$",
      "type": "string"
    },
    "side": {
      "description": "Direction of the opportunity.",
      "enum": [
        "BUY",
        "SELL"
      ],
      "type": "string"
    },
    "status": {
      "description": "Lifecycle status of this revision.",
      "enum": [
        "AVAILABLE",
        "WITHDRAWN",
        "EXPIRED",
        "REJECTED"
      ],
      "type": "string"
    },
    "status_reasons": {
      "description": "Why the candidate was rejected or withdrawn.",
      "items": {
        "maxLength": 48,
        "minLength": 1,
        "pattern": "^[A-Z][A-Z0-9_]{1,47}$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true,
      "x-gie-canonical-order": "sorted ascending",
      "x-gie-unique": true
    },
    "supersedes_candidate_id": {
      "anyOf": [
        {
          "maxLength": 36,
          "minLength": 36,
          "pattern": "^cnd_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Previous revision replaced by this record; null for revision 0."
    },
    "support_count": {
      "anyOf": [
        {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "Effective number of historical cases behind the estimate (e.g. neighbours used)."
    },
    "symbol": {
      "description": "Always XAUUSD: GIE trades only gold.",
      "enum": [
        "XAUUSD"
      ],
      "maxLength": 24,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
      "type": "string"
    },
    "unscored_reason": {
      "anyOf": [
        {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]{1,47}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Why no estimate exists; set if and only if the candidate is unscored."
    },
    "valid_until_ns": {
      "description": "Expiry instant: the candidate must not be ranked at or after it.  It is not later than the earliest expiry of its evidence.",
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer",
      "x-gie-unit": "ns since epoch, UTC"
    },
    "win_probability_frac": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "Estimated probability of a positive net result.",
      "x-gie-unit": "fraction"
    }
  },
  "required": [
    "contract",
    "schema_version",
    "producer",
    "seq",
    "run_id",
    "mode",
    "data_origin",
    "decision_time_ns",
    "as_of_time_ns",
    "candidate_id",
    "opportunity_id",
    "symbol",
    "side",
    "setup_type",
    "horizon",
    "session",
    "market_event_ids",
    "evidence_ids",
    "reference_price",
    "status",
    "status_reasons",
    "net_r_quantiles",
    "destinations",
    "contributions",
    "valid_until_ns",
    "revision"
  ],
  "title": "Candidate 1.0.0",
  "type": "object",
  "x-gie-behaviour": {
    "identity": {
      "candidate_id": "candidate_id(opportunity_id, model_version_id, revision)",
      "opportunity_id": "opportunity_id(setup_type, side, horizon, market_event_ids)"
    },
    "ordering_time": "decision_time_ns",
    "rank": {
      "name": "CANDIDATE",
      "value": 50
    },
    "stream": "candidate/<producer>",
    "transitions": [
      {
        "from": null,
        "to": [
          "AVAILABLE",
          "EXPIRED",
          "REJECTED",
          "WITHDRAWN"
        ]
      },
      {
        "from": "AVAILABLE",
        "to": [
          "AVAILABLE",
          "EXPIRED",
          "REJECTED",
          "WITHDRAWN"
        ]
      },
      {
        "from": "EXPIRED",
        "to": []
      },
      {
        "from": "REJECTED",
        "to": []
      },
      {
        "from": "WITHDRAWN",
        "to": []
      }
    ]
  },
  "x-gie-invariants": [
    {
      "id": "CAUSAL-1",
      "rule": "as_of_time_ns <= decision_time_ns (a record cannot depend on data received after it was created)"
    },
    {
      "id": "CND-1",
      "rule": "opportunity_id equals identity.opportunity_id(setup_type, side, horizon, market_event_ids)"
    },
    {
      "id": "CND-2",
      "rule": "candidate_id equals identity.candidate_id(opportunity_id, model_version_id, revision)"
    },
    {
      "id": "CND-3",
      "rule": "model_version_id, model_status, risk_unit_price and expected_net_r are all set (scored) or all null (unscored)"
    },
    {
      "id": "CND-4",
      "rule": "unscored_reason is set if and only if the candidate is unscored"
    },
    {
      "id": "CND-5",
      "rule": "a scored candidate states its uncertainty: net_r_stdev, expected_net_r_stderr or at least two quantiles"
    },
    {
      "id": "CND-6",
      "rule": "an unscored candidate has no model-derived estimates, quantiles, destinations or contributions"
    },
    {
      "id": "CND-7",
      "rule": "quantiles have strictly increasing q_frac and non-decreasing value_r"
    },
    {
      "id": "CND-8",
      "rule": "when status is AVAILABLE, valid_until_ns is later than decision_time_ns"
    },
    {
      "id": "CND-9",
      "rule": "status_reasons is non-empty when status is REJECTED or WITHDRAWN and empty when AVAILABLE"
    },
    {
      "id": "CND-10",
      "rule": "supersedes_candidate_id is null for revision 0 and otherwise equals the id of the previous revision, identity.candidate_id(opportunity_id, model_version_id, revision - 1)"
    },
    {
      "id": "CND-11",
      "rule": "memory_cutoff_time_ns <= as_of_time_ns (retrieved historical cases are prior-only)"
    }
  ]
}
